<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11-də bütün tətbiqləri görmək üçün -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Şəbəkə statusu kartı üçün -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Səsli qeyd (Google-suz, mikrofonla yazma) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Hava, yeniləmə yoxlaması, OBD Wi-Fi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Tam Skaner: Fon İzləməsi ön plan xidməti (bildirişlə) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- İkili şəbəkə: telefon hotspot (internet) + OBD Wi-Fi (lokal) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Son açılan tətbiqin slotunu işıqlandırmaq (ADB: appops set ... GET_USAGE_STATS allow) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- GPS səfər kartı -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- OBD Bluetooth adapteri -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- Android Automotive Car API (ötürmə, əyləc, sürət, gecə rejimi) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CAR_INFO" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarLauncher">

        <uses-library android:name="android.car" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">

            <!-- Adi tətbiq ikonu kimi də açılsın -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".data.SmartWindowOverlayService" android:exported="false" />

        <!-- "İndi çalır" kartı üçün media sessiyalarına giriş -->
        <service
            android:name=".data.DriveModeService"
            android:exported="false"
            android:label="Q07 Launcher — sürüş rejimi"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/drive_mode_service" />
        </service>

        <service
            android:name=".media.MediaListenerService"
            android:exported="true"
            android:label="Q07 Launcher media"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          HOME (əsas ekran) rolu ayrıca alias-dadır və STANDART OLARAQ SÖNÜLÜDÜR.
          Zavod launcher-i əsas qalır. Ayarlar → Əsas ekran bölməsindən açılıb-söndürülür.
        -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Sürətli Makrolar: 3-4 addımlı menyu gedişini yazıb bir düymə ilə icra et -->
        <activity
            android:name=".ui.MacroActivity"
            android:exported="false"
            android:label="Sürətli Makrolar"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            tools:ignore="LockedOrientationActivity" />

        <receiver
            android:name=".data.ReminderReceiver"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
